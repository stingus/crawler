{
  "name": "stingus/crawler",
  "type": "project",
  "description": "Crawler for exchange rates and weather",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Arthur Kerpician",
      "email": "arthur@bluechip.ro"
    }
  ],
  "autoload": {
    "psr-4": {
      "Stingus\\Crawler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stingus\\Crawler\\Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-dom": "*",
    "symfony/dom-crawler": "^7.0",
    "symfony/config": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/console": "^7.0",
    "symfony/mailer": "^7.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.0",
    "codeclimate/php-test-reporter": "^0.4"
  }
}


